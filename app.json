{
  "expo": {
    "name": "NetGuard",
    "slug": "netguard",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "orientation": "portrait",
    "scheme": "netguard",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash.png",
      "imageWidth": 120,
      "resizeMode": "contain",
      "backgroundColor": "#070D1F"
    },
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#070D1F",
      "translucent": false
    },
    "android": {
      "package": "com.netguard.app"
    },
    "ios": {
      "bundleIdentifier": "com.netguard.app"
    },
    "plugins": [
      "expo-router",
      "expo-background-task",
      "expo-notifications"
    ]
  }
}
