{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node", "react", "react-dom"],
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true
  },
  "include": [
    "api/**/*",
    "app/**/*",
    "src/**/*"
  ],
  "extends": "expo/tsconfig.base"
}
